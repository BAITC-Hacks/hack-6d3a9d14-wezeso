# Copy to .env. All values stay on the server.
PORT=8080
APP_ORIGIN=http://localhost:3000
DATA_DIR=./data
DATASET_DIR=.
GEMINI_API_KEY=
# The supplied hackathon dataset must remain local. Enable only for data you may transmit.
ALLOW_EXTERNAL_AI=false
# Optional initial password (at least 12 characters). Otherwise generated locally.
DEMO_PASSWORD=
COOKIE_SECURE=false
