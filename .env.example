# demo = synthetic local sandbox; supabase = authenticated local Supabase
APP_MODE=demo
PORT=3000
HOST=127.0.0.1
# Supabase CLI: npx supabase start; copy values from npx supabase status
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. Never prefix this secret with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Dataset clock is intentionally fixed for reproducible judging.
AS_OF_DATE=2026-10-01
