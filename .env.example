# Copy to .env. All values stay on the server.
PORT=8080
APP_ORIGIN=http://localhost:3000
# Supabase PostgreSQL, server-side only. API URL/anon/service-role keys are not needed.
# Leave empty: local CSV for one-command demo; Supabase when DATABASE_URL is set.
STORAGE_BACKEND=
# Use the actual DB port for your self-hosted instance (CLI commonly uses 54322).
# Percent-encode special characters in the password.
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:54322/postgres?sslmode=disable
DATABASE_URL=
# STORAGE_BACKEND=csv explicitly enables the legacy file store.
DATA_DIR=./data
DATASET_DIR=.
GEMINI_API_KEY=
# The supplied hackathon dataset must remain local. Enable only for data you may transmit.
ALLOW_EXTERNAL_AI=false
# Tool-using agent. Local Ollama requires a running model (see docs/AGENT.md).
# off = honest calculated fallback, ollama = local LLM, gemini = opted-in external LLM.
AGENT_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen3:4b
# Exam grading: ollama (local), gemini (requires key + ALLOW_EXTERNAL_AI), or off.
EXAM_AI_PROVIDER=ollama
EXAM_GEMINI_MODEL=gemini-3.8-flash
# Only for fresh --from-dataset exports or first startup in legacy CSV mode.
DEMO_PASSWORD=
COOKIE_SECURE=false
